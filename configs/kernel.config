CONFIG_64BIT=y
CONFIG_X86_64=y
CONFIG_X86=y
CONFIG_X86_GENERIC=y
CONFIG_X86_64_VERSION=1
CONFIG_SMP=y
CONFIG_HZ_250=y
CONFIG_PREEMPT_NONE=y

CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_UEVENT_HELPER_PATH=""
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y

CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_NAMESPACES=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y

# UTM's x86_64 Q35 profile disables PS/2. Its usb-kbd is attached to QEMU's
# on-board USB bus, which is backed by an EHCI controller and UHCI companion
# controllers; keep those drivers built in as well as the xHCI path used by
# newer USB devices and other VM profiles.
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_UHCI_HCD=y

# UTM's default QEMU network adapter is e1000; keep the virtio path used by
# the bundled QEMU runner as well.
CONFIG_E1000=y
CONFIG_E1000E=y

# Keep the xHCI path built in because the image boots directly from the
# initramfs and has no module loading stage before the PromptTTY service
# starts.
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_INPUT_MOUSE=y

# Also retain the QEMU/serial-runner PS/2 path for other virtual-machine
# profiles and for local fallback testing.
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
CONFIG_SERIO_LIBPS2=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_MOUSE_PS2=y

CONFIG_NET=y
# systemd-networkd's DHCP client uses AF_PACKET sockets to exchange
# broadcast DHCP frames. Keep packet sockets built in because the image has
# no module-loading stage before the network service starts.
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y
CONFIG_NETDEVICES=y

CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_HW_CONSOLE_BINDING=y
CONFIG_VT_CONSOLE=y
CONFIG_VGA_CONSOLE=y
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_PCI=y

CONFIG_EXT4_FS=y
CONFIG_ISO9660_FS=y
# systemd .automount units, including its internal binfmt_misc mount, use the
# kernel automounter. The image does not ship a separate modules tree, so keep
# this built into the kernel instead of relying on autofs4.ko at boot.
CONFIG_AUTOFS_FS=y
CONFIG_BINFMT_MISC=y
CONFIG_FHANDLE=y
CONFIG_INOTIFY_USER=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EPOLL=y
CONFIG_FANOTIFY=y

CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_KMOD=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_KALLSYMS=y
CONFIG_PRINTK=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_DEFAULT_HOSTNAME="prompttty"
CONFIG_EFI_STUB=y
